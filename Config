local function Load(messages)
    for i = 1, 100 do
        local index = math.min(
            math.ceil(i / (100 / #messages)),
            #messages
        )

        Status.Text = messages[index]
        Percent.Text = i .. "%"

        TweenService:Create(
            Bar,
            TweenInfo.new(0.025),
            {Size = UDim2.new(i / 100, 0, 1, 0)}
        ):Play()

        task.wait(0.025)
    end
end

local function Execute(url)
    Status.Text = "Verificação aprovada!"
    task.wait(0.5)
    Gui:Destroy()

    loadstring(game:HttpGet(url, true))()
end

Load({
    "Inicializando sistema...",
    "Carregando módulos...",
    "Analisando configurações...",
    "Verificando compatibilidade...",
    "Preparando interface...",
    "Verificando PlaceId..."
})

if game.PlaceId == Place1 then
    Execute(Script1)
else
    Status.Text = "Verificação secundária ativada!"
    task.wait(1)

    Bar.Size = UDim2.new(0, 0, 1, 0)

    Load({
        "Verificação secundária ativada!",
        "Analisando ambiente...",
        "Buscando segunda compatibilidade...",
        "Verificando configurações...",
        "Validando PlaceId...",
        "Finalizando verificação..."
    })

    if game.PlaceId == Place2 then
        Execute(Script2)
    else
        Status.Text = "Você só pode usar isso em partida"
        Percent.Text = ""
        Bar.Size = UDim2.new(0, 0, 1, 0)
        task.wait(3)
        Gui:Destroy()
    end
end
